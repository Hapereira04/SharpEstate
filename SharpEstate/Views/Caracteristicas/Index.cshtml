@model IEnumerable<SharpEstate.Models.Caracteristica>

@{
    ViewData["Title"] = "Gestão de Características";
}

<div class="container mt-4 mb-5">

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-list-check me-2 text-primary"></i> Características</h2>
            <p class="text-muted mb-0 small">Faça a gestão dos itens (ex: Ar Condicionado, Elevador) associados a cada grupo.</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary fw-bold shadow-sm w-100">
                <i class="bi bi-plus-lg me-1"></i> Nova Característica
            </a>
        </div>
    </div>

    <div class="card shadow-sm border-0 bg-body-tertiary text-body">
        <div class="card-body p-4">

            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle tabela-admin w-100">
                    <thead class="table-dark">
                        <tr>
                            <th class="ps-3">
                                @Html.DisplayNameFor(model => model.Nome)
                            </th>
                            <th>
                                Grupo
                            </th>
                            <th class="text-end pe-4" style="width: 150px;">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-bold">
                                    @Html.DisplayFor(modelItem => item.Nome)
                                </td>
                                <td>
                                    <span class="badge bg-secondary text-white">
                                        @Html.DisplayFor(modelItem => item.GrupoCaracteristica.Nome)
                                    </span>
                                </td>
                                <td class="text-end pe-3">
                                    <div class="d-flex justify-content-end gap-3">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Editar">
                                            <i class="bi bi-pencil-square"></i>
                                        </a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info" title="Detalhes">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Apagar">
                                            <i class="bi bi-trash3"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>