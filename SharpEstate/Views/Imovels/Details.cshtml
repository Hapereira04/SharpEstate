@model SharpEstate.Models.Imovel
@using System.Globalization

@{
    ViewData["Title"] = Model.Titulo;
    var fotoCapa = Model.Fotos?.FirstOrDefault(f => f.IsCapa) ?? Model.Fotos?.FirstOrDefault();
    var outrasFotos = Model.Fotos?.Where(f => f != fotoCapa).ToList() ?? new List<SharpEstate.Models.FotoImovel>();

    // Formatação de moeda para Portugal
    var ptCulture = new CultureInfo("pt-PT");
}

<style>
    .gallery-hero {
        height: 500px;
        object-fit: cover;
        cursor: pointer;
        border-radius: 12px;
    }

    .gallery-thumb {
        height: 120px;
        object-fit: cover;
        cursor: zoom-in;
        border-radius: 8px;
        transition: 0.3s;
    }

        .gallery-thumb:hover {
            filter: brightness(0.8);
        }

    .sticky-sidebar {
        position: sticky;
        top: 20px;
    }

    .icon-box {
        background: #f8f9fa;
        border-radius: 50%;
        width: 40px;
        height: 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .consultor-card {
        background: #fdfdfd;
        border: 1px solid #eee;
    }

    .breadcrumb-link {
        text-decoration: none;
        color: #6c757d;
        font-size: 0.9rem;
    }

        .breadcrumb-link:hover {
            color: #dc3545;
        }
    /* Vermelho estilo ERA */
</style>

<div class="container mt-4 mb-5">

    <div class="alert alert-warning">
        Debug: O sistema detetou @(Model.Fotos?.Count ?? 0) fotos na base de dados para este imóvel.
    </div>

    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-2">
                <li class="breadcrumb-item"><a href="/" class="breadcrumb-link">Homepage</a></li>
                <li class="breadcrumb-item"><a href="/Imoveis" class="breadcrumb-link">Comprar</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Freguesia, @Model.Concelho</li>
            </ol>
        </nav>
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-danger mb-2 px-3 py-2 text-uppercase tracking-wide">@Model.TipoNegocio</span>
                <span class="badge bg-secondary mb-2 px-3 py-2 text-uppercase tracking-wide">@Model.Status</span>
                <h1 class="fw-bold mb-0 text-dark">@Model.Titulo</h1>
                <p class="text-muted mt-1 mb-0 fs-5">📍 @Model.Freguesia, @Model.Concelho, @Model.Distrito &nbsp;|&nbsp; <small>Ref: @Model.Id.ToString("D6")</small></p>
            </div>
            <div class="d-none d-md-block">
                <button class="btn btn-outline-secondary rounded-circle p-2 mx-1" title="Partilhar">🔗</button>
                <button class="btn btn-outline-danger rounded-circle p-2 mx-1" title="Favorito">❤️</button>
            </div>
        </div>
    </div>

    <div class="row">

        <div class="col-lg-8">

            <div class="gallery-container mb-5">
                @if (fotoCapa != null)
                {
                    <div class="mb-2 position-relative">
                        <img src="data:@fotoCapa.ContentType;base64,@Convert.ToBase64String(fotoCapa.DadosImagem)"
                             class="img-fluid w-100 shadow-sm gallery-hero"
                             onclick="abrirModalGaleria(this.src)"
                             alt="Foto Principal" />
                        <div class="position-absolute bottom-0 start-0 m-3 badge bg-dark opacity-75 fs-6">
                            📸 @Model.Fotos.Count Fotos
                        </div>
                    </div>
                }

                @if (outrasFotos.Any())
                {
                    <div class="row g-2">
                        @foreach (var foto in outrasFotos.Take(4)) // Mostra apenas as 4 primeiras miniaturas
                        {
                            <div class="col-3">
                                <img src="data:@foto.ContentType;base64,@Convert.ToBase64String(foto.DadosImagem)"
                                     class="img-fluid w-100 shadow-sm gallery-thumb"
                                     onclick="abrirModalGaleria(this.src)"
                                     alt="Foto" />
                            </div>
                        }
                    </div>
                }
            </div>

            <hr class="text-muted" />

            <div class="row text-center mb-5 mt-4">
                <div class="col-6 col-md-3 mb-3">
                    <div class="icon-box mx-auto text-primary mb-2">🛏️</div>
                    <span class="text-muted d-block small">Quartos</span>
                    <strong class="fs-5">@Model.Quartos</strong>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <div class="icon-box mx-auto text-primary mb-2">🛁</div>
                    <span class="text-muted d-block small">Casas de Banho</span>
                    <strong class="fs-5">@Model.CasasBanho</strong>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <div class="icon-box mx-auto text-primary mb-2">📐</div>
                    <span class="text-muted d-block small">Área Útil</span>
                    <strong class="fs-5">@Model.AreaUtil m²</strong>
                </div>
                <div class="col-6 col-md-3 mb-3">
                    <div class="icon-box mx-auto text-primary mb-2">⚡</div>
                    <span class="text-muted d-block small">Cert. Energético</span>
                    <strong class="fs-5 text-success">@Model.Certificado</strong>
                </div>
            </div>

            <div class="mb-5">
                <h3 class="fw-bold mb-4">Descrição</h3>
                <p style="white-space: pre-line; line-height: 1.8; font-size: 1.1rem; color: #444;">
                    @Model.Descricao
                </p>
            </div>

            @if (Model.Caracteristicas != null && Model.Caracteristicas.Any())
            {
                <div class="mb-5 bg-light p-4 rounded-4">
                    <h3 class="fw-bold mb-4">Outras Características</h3>
                    <div class="row">
                        @foreach (var grupo in Model.Caracteristicas.GroupBy(c => c.Grupo))
                        {
                            <div class="col-md-6 mb-3">
                                <h6 class="fw-bold text-uppercase text-muted mb-2">@grupo.Key</h6>
                                <ul class="list-unstyled mb-0" style="columns: 1;">
                                    @foreach (var carac in grupo)
                                    {
                                        <li class="mb-1">✔️ @carac.Nome</li>
                                    }
                                </ul>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-4">
            <div class="sticky-sidebar">

                <div class="card border-0 shadow-lg rounded-4 mb-4">
                    <div class="card-body p-4 text-center">
                        <span class="text-muted text-uppercase tracking-wide small fw-bold">Preço de @Model.TipoNegocio</span>
                        <h2 class="display-5 fw-bold text-success mt-2 mb-0">@Model.Preco.ToString("C0", ptCulture)</h2>

                        @if (Model.AreaUtil > 0)
                        {
                            var precoM2 = Model.Preco / (decimal)Model.AreaUtil;
                            <p class="text-muted small mt-2">@precoM2.ToString("C0", ptCulture) / m²</p>
                        }

                        <hr class="my-4" />

                        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning btn-lg w-100 mb-2 rounded-pill fw-bold">
                            ✏️ Editar Imóvel
                        </a>
                        <a asp-action="Index" class="btn btn-light w-100 rounded-pill">Voltar à Lista</a>
                    </div>
                </div>

                <div class="card consultor-card shadow-sm rounded-4">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4 text-center">Fale com o Consultor</h5>

                        <div class="d-flex align-items-center mb-4">
                            <img src="https://ui-avatars.com/api/?name=Consultor+Sharp&background=0D8ABC&color=fff&size=80" class="rounded-circle shadow-sm me-3" alt="Consultor">
                            <div>
                                <h5 class="mb-1 fw-bold">Consultor SharpEstate</h5>
                                <p class="text-muted mb-0 small">Especialista em @Model.Concelho</p>
                            </div>
                        </div>

                        <a href="tel:+351912345678" class="btn btn-dark btn-lg w-100 rounded-pill mb-3 fw-bold d-flex justify-content-center align-items-center">
                            📞 Contactar: 912 345 678
                        </a>
                        <button class="btn btn-outline-primary btn-lg w-100 rounded-pill fw-bold">
                            ✉️ Pedir Informação
                        </button>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="galeriaModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-xl">
        <div class="modal-content bg-transparent border-0">
            <div class="modal-header border-0 pb-0">
                <button type="button" class="btn-close btn-close-white ms-auto" data-bs-dismiss="modal" aria-label="Close" style="filter: invert(1);"></button>
            </div>
            <div class="modal-body text-center p-0">
                <img id="imagemExpandida" src="" class="img-fluid rounded shadow-lg" style="max-height: 85vh; border: 4px solid white;" />
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Função para abrir o Modal de Fotos
        function abrirModalGaleria(srcDaImagem) {
            document.getElementById('imagemExpandida').src = srcDaImagem;
            var myModal = new bootstrap.Modal(document.getElementById('galeriaModal'));
            myModal.show();
        }
    </script>
}