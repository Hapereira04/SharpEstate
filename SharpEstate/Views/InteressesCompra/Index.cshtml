@model IEnumerable<SharpEstate.Models.InteresseCompra>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Cliente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.PrecoMaximo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Tipologias)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Concelhos)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Urgencia)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataRegisto)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Cliente.Nome)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.PrecoMaximo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Tipologias)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Concelhos)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Urgencia)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.DataRegisto)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ClienteId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ClienteId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ClienteId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
